# Required: OpenAI / OpenRouter API key (the agent call needs it)
OPENAI_API_KEY=sk-...

# Optional: OpenAI-compatible endpoint. Defaults to api.openai.com.
# OpenRouter: https://openrouter.ai/api/v1
# Local Ollama: http://localhost:11434/v1
# OPENAI_BASE_URL=

# Optional: model name (default: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

# Optional: reject non-local LLM endpoints (1 = local-only)
LLM_LOCAL_ONLY=0

# Optional: extra allowlisted LLM hosts, comma-separated
# ALLOWED_LLM_HOSTS=internal-llm.example

# Webhook security. If empty, auth is disabled for local development.
# Set a strong value in any shared environment.
WEBHOOK_API_KEY=

# Optional webhook limits
WEBHOOK_RATE_LIMIT=30
WEBHOOK_RATE_WINDOW=60
WEBHOOK_MAX_BODY_BYTES=1048576

# Optional: structured agent audit log
AUDIT_LOG_PATH=outputs/audit/agent_runs.jsonl

# Optional: override the ChromaDB path (useful for read-only containers)
# CHROMA_PATH=/tmp/chroma
